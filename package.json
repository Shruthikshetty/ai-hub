    "react-resizable-panels": "^4.18.0",
    "react-router": "^7.13.1",
    "react-virtuoso": "^4.18.20",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "streamdown": "^2.7.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "use-stick-to-bottom": "^1.1.6",
    "vite": "^7.2.6",
    "vite-plugin-pages": "^0.33.3",
    "vitest": "^4.1.12",
    "zustand": "^5.0.16"
  }
}
