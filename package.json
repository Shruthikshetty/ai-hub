{
  "name": "ai-hub",
  "version": "0.3.1",
  "description": "AI Hub - Your Personal AI aggregator",
  "main": "./out/main/index.js",
  "author": "shruthik shetty",
  "homepage": "https://github.com/shruthikshetty/ai-hub",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "bun run typecheck:node && bun run typecheck:web",
    "generate:http-codes": "npx tsx scripts/generate-http-status-codes.ts",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "bun run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "bun run build && electron-builder --dir",
    "build:win": "bun run build && electron-builder --win",
    "build:mac": "bun run build && electron-builder --mac",
    "build:linux": "bun run build && electron-builder --linux",
    "build:linux:x64": "bun run build && electron-builder --linux --x64",
    "build:linux:arm64": "bun run build && electron-builder --linux --arm64",
    "build:linux:all": "bun run build && electron-builder --linux --x64 --arm64",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:studio": "drizzle-kit studio",
    "drizzle:push": "drizzle-kit push",
    "test": "vitest"
  },
  "dependencies": {
    "@ai-sdk/alibaba": "^1.0.23",
    "@ai-sdk/cerebras": "^2.0.45",
    "@ai-sdk/cohere": "^3.0.35",
    "@ai-sdk/elevenlabs": "^2.0.33",
    "@ai-sdk/fireworks": "^2.0.42",
    "@ai-sdk/google": "^3.0.43",
    "@ai-sdk/groq": "^3.0.29",
    "@ai-sdk/huggingface": "^1.0.39",
    "@ai-sdk/mistral": "^3.0.29",
    "@ai-sdk/openai": "^3.0.136",
    "@ai-sdk/openai-compatible": "^2.0.90",
    "@ai-sdk/togetherai": "^2.0.41",
    "@ai-sdk/xai": "^3.0.72",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@hono/node-server": "^2.1.6",
    "@hono/zod-openapi": "^1.6.3",
    "@libsql/client": "^0.17.0",
    "@openrouter/ai-sdk-provider": "^2.3.0",
    "ai": "^6.0.322",
    "axios": "^1.21.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "^0.8.3",
    "electron-context-menu": "^4.1.2",
    "electron-updater": "^6.3.9",
    "grammy": "^1.46.0",
    "hono": "^4.13.16",
    "hono-pino": "^0.10.3",
    "nanoid": "^6.0.2",
    "ollama-ai-provider-v2": "^3.4.0",
    "pino": "^10.4.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ai-sdk/react": "^3.0.107",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@radix-ui/react-use-controllable-state": "^1.3.0",
    "@scalar/hono-api-reference": "^0.12.17",
    "@streamdown/cjk": "^1.0.4",
    "@streamdown/code": "^2.0.0",
    "@streamdown/math": "^1.0.3",
    "@streamdown/mermaid": "^1.0.3",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.105.3",
    "@tanstack/react-query-devtools": "^5.105.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.1",
    "drizzle-kit": "^0.31.11",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "lucide-react": "^1.67.0",
    "media-chrome": "^4.19.4",
    "motion": "^14.9.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "radix-ui": "^1.8.1",
